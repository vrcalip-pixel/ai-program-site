---
/**
 * The landing page: the depth pathway, ported from prototype-depth.html.
 * The canvas code below is vanilla JS kept as close to the prototype as possible
 * (BRIEF §5, §11). Do not rewrite it in a framework; do not redesign.
 *
 * Changes from the prototype are limited to routing: every node now links to a
 * real page (course, pathway anchor, or content page) instead of the prototype's
 * in-page course view.
 */
import { BASE } from '../lib/url';
---
<div id="map" aria-label="Explore the program" data-base={BASE}>
  <canvas id="space" aria-hidden="true"></canvas>
  <div id="vignette" aria-hidden="true"></div>
  <div class="hud">
    <h1>Explore the program.</h1>
    <p id="hudhint">Click a point to travel to it. Scroll to move through the courses; scroll back to return.</p>
    <div class="row"><button type="button" class="ghost" id="recenter">Recenter</button><button type="button" class="ghost sound" id="sound" aria-pressed="false" aria-label="Experience: turn on sound, immersive visuals and hands-free camera control (video stays on this device)"><span class="lbl">Experience</span></button></div>
  </div>
  <div class="legend" aria-hidden="true"><span><i style="background:#D4A054"></i>Courses</span><span><i style="background:#6FA8BF"></i>Credentials</span><span><i style="background:#9FB0BE"></i>People and pages</span></div>
  <aside class="panel-node" id="panel" aria-live="polite">
    <button type="button" class="close" id="pclose" aria-label="Close">×</button>
    <span class="kind" id="pkind"></span><h2 id="ptitle"></h2><p id="pdesc"></p>
    <div class="acts"><button type="button" class="ghost sm" id="pprev" aria-label="Back, toward the start">‹ Back</button><a class="see sm" href="#" id="plink">See the course</a><button type="button" class="ghost sm" id="pnext" aria-label="Deeper, toward the degree">Deeper ›</button><button type="button" class="ghost sm back" id="pback">Map</button></div>
  </aside>
  <!-- Every destination, for screen readers and for reduced-motion visitors (visible then). The map is never the only route. -->
  <ul class="sr destinations" id="srlist" aria-label="All destinations"></ul>
</div>

<script>
/* ===== depth pathway: the camera travels INTO the program ===== */
const mapEl=document.getElementById('map')!;const BASE=mapEl.dataset.base||'';
const NODES:any[]=[
 {id:'ai40',k:'course',t:'AI and Machine Learning Foundations',n:'AI 40',x:-612,y:-198,z:0,c:'#D4A054',d:'Your starting point. What AI and machine learning are, where they show up at work, and how to evaluate a tool before you trust it.',href:BASE+'/courses/ai-40'},
 {id:'ai45',k:'course',t:'The Fundamentals of Generative AI',n:'AI 45',x:673,y:-232,z:650,c:'#D4A054',d:'How generative models work in plain terms, and how to direct them with intent.',href:BASE+'/courses/ai-45'},
 {id:'ai60',k:'course',t:'Applied Conversational and Agentic AI',n:'AI 60',x:-170,y:667,z:1300,c:'#D4A054',d:'Build assistants and agents that do things, not just answer.',href:BASE+'/courses/ai-60'},
 {id:'ai65',k:'course',t:'Applied Multi-Modal AI',n:'AI 65',x:134,y:-706,z:1950,c:'#D4A054',d:'Image, audio, video and text working together in real deliverables.',href:BASE+'/courses/ai-65'},
 {id:'ai70',k:'course',t:'Human–AI Collaboration and Workflow Automation',short:'Human–AI Collaboration and Workflow',n:'AI 70',x:-621,y:-39,z:2600,c:'#D4A054',d:'Automate real work while keeping a person accountable.',href:BASE+'/courses/ai-70'},
 {id:'ai80',k:'course',t:'Applied AI Integration Studio',n:'AI 80',x:440,y:132,z:3250,c:'#D4A054',d:'The capstone. Scope a real problem, build a complete AI solution, present it to people who could hire you.',href:BASE+'/courses/ai-80'},
 {id:'c6',k:'credential',t:'AI Literacy · 6 units',n:'Certificate of Accomplishment · In development',x:813,y:222,z:830,c:'#6FA8BF',d:'Two courses. The first place you can stop and have something real to show. Expected to be offered no later than Spring 2027.',link:'Pathway',href:BASE+'/pathway',sats:[{n:'AI 40'},{n:'AI 45'}]},
 {id:'c12',k:'credential',t:'AI Fluency · 12 units',n:'Certificate of Achievement · In development',x:-522,y:-1148,z:2100,c:'#6FA8BF',d:'Four courses, transcripted. Currently moving through curriculum review.',link:'Pathway',href:BASE+'/pathway',sats:[{n:'AI 40'},{n:'AI 45'},{n:'AI 60'},{n:'AI 65'}]},
 {id:'c18',k:'credential',t:'AI for Digital Transformation · 18 units',n:'Certificate of Achievement · Planned',x:1270,y:-680,z:3420,c:'#6FA8BF',d:'All six AI courses. The financial-aid eligible tier.',link:'Pathway',href:BASE+'/pathway',sats:[{n:'AI 40'},{n:'AI 45'},{n:'AI 60'},{n:'AI 65'},{n:'AI 70'},{n:'AI 80'}]},
 {id:'as',k:'credential',t:'AI for Digital Transformation · 60 units',n:'Associate in Science · Approved',x:25,y:-200,z:4000,c:'#6FA8BF',d:'The six AI courses plus supporting coursework and general education. Supporting courses shown are those with outlines on file; the full approved list appears on the Pathway page.',link:'Pathway',href:BASE+'/pathway',sats:[{n:'COSP 38'},{n:'CS 31'},{n:'COSN 250'},{n:'GE'}]},
 {id:'coun',k:'page',t:'For counselors and advisors',n:'Units, sequencing, plan code',x:-1120,y:-470,z:250,c:'#9FB0BE',d:'Everything you need to place a student and answer their questions.',link:'Open page',href:BASE+'/counselors'},
 {id:'about',k:'page',t:'About the program',n:'Ethics-first, no code required',x:1392,y:-738,z:1230,c:'#9FB0BE',d:'Why the program exists, who teaches it, and how it thinks about AI.',link:'Open page',href:BASE+'/about'},
 {id:'emp',k:'page',t:'For employers and partners',n:'What graduates can do',x:1364,y:746,z:3080,c:'#9FB0BE',d:'Skills, advisory board, and how to work with the program.',link:'Open page',href:BASE+'/employers'},
];
const PATH=['ai40','ai45','ai60','ai65','ai70','ai80'];
const LINKS=[['ai40','ai45'],['ai45','ai60'],['ai60','ai65'],['ai65','ai70'],['ai70','ai80'],['ai45','c6'],['ai65','c12'],['ai80','c18'],['c18','as'],['ai80','as'],['ai40','coun'],['ai80','emp'],['ai45','about']];
const byId:Record<string,any>=Object.fromEntries(NODES.map(n=>[n.id,n]));
// Scroll / arrows / swipe / Back / Deeper travel through the six courses only. Credential and page
// nodes stay clickable; from one of those, Deeper goes to the next course beyond it in depth, Back to the course before it.
const ORDER=PATH;
function courseFrom(n:any,dir:number){const i=ORDER.indexOf(n.id);
  if(i>=0)return i+dir>=0&&i+dir<ORDER.length?byId[ORDER[i+dir]]:null;
  const cs=dir>0?ORDER.filter(id=>byId[id].z>n.z):ORDER.filter(id=>byId[id].z<n.z).reverse();return cs.length?byId[cs[0]]:null}

// screen-reader list of every destination (visible under prefers-reduced-motion)
document.getElementById('srlist')!.innerHTML=[...NODES].sort((a,b)=>a.z-b.z).map(n=>`<li><a href="${n.href}"><b>${n.n.split(' · ')[0]}</b><span>${n.t}</span></a></li>`).join('');

const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
const sc=document.getElementById('space') as HTMLCanvasElement,sx=sc.getContext('2d')!,hud=document.querySelector('.hud') as HTMLElement,panel=document.getElementById('panel')!;
let SW=0,SH=0,stars:any[]=[],net:any[]=[],rip:any[]=[],comets:any[]=[],nextComet=0,hover:any=null,active:any=null,pathIdx=-1,amb=0;
const F=1000;                                            // focal length: bigger = flatter perspective (was 1250; shortened for stronger depth)
const cam={x:0,y:0,z:-800},tgt={x:0,y:0,z:-800},ptr={x:-1e4,y:-1e4},tilt={x:0,y:0};
const REST={z:-800};
let DPR=1;                                               // render at device resolution (capped) so labels stay crisp
const RINGS=false;                                       // depth rings (see draw)
function sres(){SW=innerWidth;SH=innerHeight;DPR=Math.min(1.5,devicePixelRatio||1);sc.width=Math.round(SW*DPR);sc.height=Math.round(SH*DPR);sc.style.width=SW+'px';sc.style.height=SH+'px';
  if(!stars.length)for(let i=0;i<(innerWidth<820?160:420);i++)stars.push({x:(Math.random()-.5)*4200,y:(Math.random()-.5)*2600,z:-1600+Math.random()*7000,r:.5+Math.random()*1.5,ph:Math.random()*6.283,sp:.35+Math.random()*.7});
  if(!net.length)for(let i=0;i<(innerWidth<820?70:170);i++){net.push({x:(Math.random()-.5)*3800,y:(Math.random()-.5)*2400,z:-1400+Math.random()*6800,ph:Math.random()*6.283})}
  fit()}
// rest camera. Phones pull back and aim left so AI 40, the starting point, sits in frame (it is off the left edge when centred)
function fit(){const mob=innerWidth<820;tgt.z=mob?REST.z-600:REST.z;tgt.x=mob?-260:0;tgt.y=mob?-60:0}
addEventListener('resize',sres);sres();

// liquid wave in screen space; nearer layers move more
function wave(px:number,py:number,near:number){let ox=0,oy=0;for(const r of rip){const dx=px-r.x,dy=py-r.y,d=Math.hypot(dx,dy)||1,b=(d-r.r)/110;
  if(b>-2.5&&b<2.5){const g=Math.exp(-b*b);const a=r.amp*g*(0.35+0.65*near);ox+=dx/d*a;oy+=dy/d*a}}return{ox,oy}}
// perspective projection. Returns null when behind the camera.
function proj(x:number,y:number,z:number){const d=z-cam.z;if(d<-F*0.55)return null;const s=F/(F+d);
  let px=SW/2+(x-cam.x)*s+tilt.x*(1-s)*40,py=SH/2+(y-cam.y)*s+tilt.y*(1-s)*40;
  const wv=wave(px,py,Math.min(1,s));return{x:px+wv.ox,y:py+wv.oy,s,d,near:0,z:0}}

// star halos, pre-rendered once (same gradient the prototype built per star per frame; drawn scaled instead)
const SPR=(()=>{const mk=(c1:string,c2:string)=>{const s=96,c=document.createElement('canvas');c.width=c.height=s;const g=c.getContext('2d')!;const r=s/2;const gr=g.createRadialGradient(r,r,0,r,r,r);gr.addColorStop(0,c1);gr.addColorStop(.3,c2);gr.addColorStop(1,'rgba(159,176,190,0)');g.fillStyle=gr;g.fillRect(0,0,s,s);return c};
  return{warm:mk('rgba(241,217,166,1)','rgba(212,160,84,.34)'),cool:mk('rgba(238,242,245,1)','rgba(159,176,190,.34)')}})();
function mix(a:string,b:string,t:number){const pa=parseInt(a.slice(1),16),pb=parseInt(b.slice(1),16);const r=Math.round(((pa>>16)&255)*(1-t)+((pb>>16)&255)*t),g=Math.round(((pa>>8)&255)*(1-t)+((pb>>8)&255)*t),bl=Math.round((pa&255)*(1-t)+(pb&255)*t);return `rgb(${r},${g},${bl})`}
let idle=0;
function draw(now:number){
  // ripple values are initialized before first draw; age clamps at 0 (frame timestamps can precede performance.now() at click)
  rip=rip.filter(r=>{const age=Math.max(0,(now-r.born)/1000);r.r=age*380;r.amp=Math.max(0,46*(1-age/3.2));r.life=Math.max(0,1-age/3.2);return age<3.2});
  amb+=((document.body.classList.contains('ambient')?1:0)-amb)*.03;
  idle+=(active?0:1-idle)*.02;const breathe=Math.sin(now/5200)*90*idle,sway=Math.sin(now/7300)*24*idle;
  cam.x+=(tgt.x+sway-cam.x)*.06;cam.y+=(tgt.y-cam.y)*.06;cam.z+=(tgt.z+breathe-cam.z)*.06;
  sx.setTransform(DPR,0,0,DPR,0,0);sx.clearRect(0,0,SW,SH);
  const t=now/1000;
  // depth field
  {const vg=sx.createLinearGradient(0,0,0,SH);
   vg.addColorStop(0,`rgba(${Math.round(16+amb*14)},${Math.round(30+amb*8)},${Math.round(46-amb*6)},.95)`);vg.addColorStop(.5,'rgba(11,22,34,0)');vg.addColorStop(1,`rgba(${Math.round(3+amb*10)},${Math.round(7+amb*5)},12,.92)`);
   sx.globalAlpha=1;sx.fillStyle=vg;sx.fillRect(0,0,SW,SH);
   // elliptical vignette that follows the viewport's aspect ratio, so it never reads as a circle on a wide screen
   sx.save();sx.translate(SW/2,SH/2);sx.scale(SW/2,SH/2);
   const bowl=sx.createRadialGradient(0,0,.7,0,0,1.6);bowl.addColorStop(0,'rgba(2,5,9,0)');bowl.addColorStop(.5,'rgba(2,5,9,.1)');bowl.addColorStop(1,'rgba(2,5,9,.34)');sx.fillStyle=bowl;sx.fillRect(-1,-1,2,2);sx.restore();
   if(amb>.01){const k=Math.max(SW,SH);const fs:[number,number,string,number,number][]=[[SW*.28,SH*.3,'24,84,96',.42,.7],[SW*.74,SH*.7,'190,120,48',.34,.65],[SW*.5,SH*.45,'240,190,110',.10,.45]];
     for(const [fx,fy,col,al,rr] of fs){const g=sx.createRadialGradient(fx,fy,0,fx,fy,k*rr);g.addColorStop(0,`rgba(${col},${al*amb})`);g.addColorStop(.55,`rgba(${col},${al*.3*amb})`);g.addColorStop(1,`rgba(${col},0)`);sx.fillStyle=g;sx.fillRect(0,0,SW,SH)}}}
  // depth rings: off. They read as faint ovals on large screens; node size, label scale and star parallax carry the depth.
  // Flip RINGS to true to restore the receding tunnel (one ring per course distance).
  if(RINGS)for(const id of [...PATH,'as']){const n=byId[id];const p=proj(0,-30,n.z);if(!p)continue;const R=1500*p.s;
    const fade=Math.max(0,1-Math.max(0,R-SH*.7)/(SH*.6));                                   // dissolve as the camera passes through a ring
    sx.strokeStyle=id==='as'?'#6FA8BF':'#D4A054';sx.globalAlpha=.06*Math.min(1,p.s*2.5)*fade;sx.lineWidth=1;sx.beginPath();sx.ellipse(p.x,p.y,R,R*.62,0,0,6.283);sx.stroke()}
  // network (deep layer): 3D points, edges to nearby points, cursor pull in screen space
  const nps:any[]=[];for(const n of net){if(n.z-cam.z<-400)n.z+=6800;if(n.z-cam.z>6400)n.z-=6800;const p=proj(n.x+Math.sin(t*.5+n.ph)*30,n.y+Math.cos(t*.4+n.ph)*30,n.z);if(!p)continue;
    const dd=Math.hypot(ptr.x-p.x,ptr.y-p.y),near=dd<220?(1-dd/220):0;if(near){p.x+=(ptr.x-p.x)*near*.35;p.y+=(ptr.y-p.y)*near*.35}p.near=near;p.z=n.z;nps.push(p)}
  sx.lineWidth=1;
  for(let i=0;i<nps.length;i++){const a=nps[i];for(let j=i+1;j<nps.length;j++){const b=nps[j];if(Math.abs(a.z-b.z)>900)continue;const d=Math.hypot(a.x-b.x,a.y-b.y);if(d>150)continue;
      const nr=Math.max(a.near,b.near);sx.strokeStyle=nr>.05?'#6FA8BF':'#7A8C99';sx.globalAlpha=(1-d/150)*(.06+nr*.3)*Math.min(1,a.s*1.6);sx.beginPath();sx.moveTo(a.x,a.y);sx.lineTo(b.x,b.y);sx.stroke()}
    sx.fillStyle='#9FB0BE';sx.globalAlpha=(.16+a.near*.5)*Math.min(1,a.s*1.6);sx.beginPath();sx.arc(a.x,a.y,(1+a.near*1.6)*Math.max(.5,a.s*1.4),0,6.283);sx.fill()}
  // stars: recycle as the camera moves; breathe softly; brighten in a passing crest
  for(const st of stars){if(st.z-cam.z<-500)st.z+=7000;if(st.z-cam.z>6500)st.z-=7000;const p=proj(st.x,st.y,st.z);if(!p)continue;
    let crest=0;for(const r of rip){const b=(Math.hypot(p.x-r.x,p.y-r.y)-r.r)/110;if(b>-2&&b<2)crest+=Math.exp(-b*b)*r.life}
    const pulse=Math.min(1,.5+.5*Math.sin(t*st.sp*.55+st.ph)+crest*.9),warm=st.ph>4.7;
    const core=(st.r*.7+.35)*Math.max(.4,p.s*1.3)*(0.85+.3*pulse),halo=(4+st.r*3.5)*Math.max(.5,p.s*1.3)*(0.8+.4*pulse),vis=Math.min(1,p.s*1.8);
    sx.globalAlpha=(.26*pulse+.06)*vis;sx.drawImage(warm?SPR.warm:SPR.cool,p.x-halo,p.y-halo,halo*2,halo*2);
    sx.fillStyle=warm?'#F7E7C6':'#EEF2F5';sx.globalAlpha=(.3+.35*pulse)*vis;sx.beginPath();sx.arc(p.x,p.y,core,0,6.283);sx.fill()}
  // comets (screen space, Experience only)
  if(amb>.5&&now>nextComet){nextComet=now+7000+Math.random()*8000;const kind=['cross','recede','approach'][Math.floor(Math.random()*3)];const fromLeft=Math.random()<.5,dir=fromLeft?1:-1;let c:any={kind,born:now,dur:1500+Math.random()*900};
    if(kind==='cross'){const ang=(0.15+Math.random()*0.3)*(Math.random()<.5?1:-1);c.x0=fromLeft?-60:SW+60;c.y0=SH*(0.08+Math.random()*0.5);c.x1=c.x0+dir*SW*(0.45+Math.random()*0.3);c.y1=c.y0+Math.tan(ang)*Math.abs(c.x1-c.x0);c.s0=1;c.s1=.9}
    else if(kind==='recede'){c.x0=fromLeft?SW*0.1:SW*0.9;c.y0=SH*(0.55+Math.random()*0.35);c.x1=SW*(0.35+Math.random()*0.3);c.y1=SH*(0.15+Math.random()*0.25);c.s0=1.6;c.s1=.15;c.dur+=600}
    else {c.x0=SW*(0.3+Math.random()*0.4);c.y0=SH*(0.12+Math.random()*0.25);c.x1=fromLeft?-40:SW+40;c.y1=SH*(0.55+Math.random()*0.4);c.s0=.12;c.s1=1.7}
    comets.push(c);cometSound(kind,dir)}
  comets=comets.filter(c=>now-c.born<c.dur);
  for(const c of comets){const u=Math.min(1,(now-c.born)/c.dur);const e=c.kind==='approach'?u*u*(3-2*u)*u*0.4+u*0.6:1-Math.pow(1-u,1.8);const sc_=c.s0+(c.s1-c.s0)*e;const fade=Math.pow(Math.sin(Math.PI*Math.min(1,u*1.05)),0.7);
    const hx=c.x0+(c.x1-c.x0)*e+tilt.x*10,hy=c.y0+(c.y1-c.y0)*e+tilt.y*10;const vx=c.x1-c.x0,vy=c.y1-c.y0,L=Math.hypot(vx,vy)||1,ux=vx/L,uy=vy/L;const tl=Math.min(220,90*sc_+40)*(0.4+0.6*Math.min(1,u*3));const tx=hx-ux*tl,ty=hy-uy*tl;
    const g=sx.createLinearGradient(tx,ty,hx,hy);g.addColorStop(0,'rgba(241,217,166,0)');g.addColorStop(.75,`rgba(241,217,166,${.3*fade*Math.min(1,sc_)})`);g.addColorStop(1,`rgba(255,250,240,${.9*fade*Math.min(1,sc_+.2)})`);
    sx.save();sx.globalCompositeOperation='lighter';sx.strokeStyle=g;sx.lineWidth=Math.max(.4,1.8*sc_);sx.lineCap='round';sx.globalAlpha=1;sx.beginPath();sx.moveTo(tx,ty);sx.lineTo(hx,hy);sx.stroke();
    sx.fillStyle='#FFFFFF';sx.shadowColor='#F1D9A6';sx.shadowBlur=10+12*sc_;sx.globalAlpha=.9*fade*Math.min(1,sc_+.15);sx.beginPath();sx.arc(hx,hy,Math.max(.5,1.7*sc_),0,6.283);sx.fill();sx.restore()}
  // liquid sheen
  if(rip.length){sx.save();sx.globalCompositeOperation='lighter';for(const r of rip){const R=r.r,W=110,a=r.life*r.life;if(R<1)continue;
      const g=sx.createRadialGradient(r.x,r.y,Math.max(0,R-W*1.6),r.x,r.y,R+W*1.2);g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(.42,`rgba(111,168,191,${.05*a})`);g.addColorStop(.58,`rgba(238,242,245,${.16*a})`);g.addColorStop(.66,`rgba(241,217,166,${.10*a})`);g.addColorStop(.8,'rgba(0,0,0,0)');
      sx.globalAlpha=1;sx.fillStyle=g;sx.beginPath();sx.arc(r.x,r.y,R+W*1.2,0,6.283);sx.fill()}sx.restore()}
  // project nodes
  const P:Record<string,any>={};for(const n of NODES){P[n.id]=proj(n.x,n.y,n.z)}
  // links, drawn far to near so nearer lines sit on top
  const ls=LINKS.map(([a,b])=>({a,b,depth:(byId[a].z+byId[b].z)/2})).sort((u,v)=>v.depth-u.depth);
  for(const l of ls){const pa=P[l.a],pb=P[l.b];if(!pa||!pb)continue;const onPath=PATH.includes(l.a)&&PATH.includes(l.b);const vis=Math.min(1,Math.min(pa.s,pb.s)*2.2);
    sx.strokeStyle=onPath?'#D4A054':'#6FA8BF';sx.globalAlpha=(onPath?.5:.4)*vis;sx.lineWidth=(onPath?1.8:1.1)*Math.max(.5,Math.min(pa.s,pb.s)*1.6);
    if(!onPath)sx.setLineDash([5,5]);sx.beginPath();sx.moveTo(pa.x,pa.y);sx.lineTo(pb.x,pb.y);sx.stroke();sx.setLineDash([])}
  // travelling light along the pathway (interpolated in 3D)
  {const T=(now/1000)%PATH.length,i=Math.floor(T),f=T-i;if(i<PATH.length-1){const A=byId[PATH[i]],B=byId[PATH[i+1]],p=proj(A.x+(B.x-A.x)*f,A.y+(B.y-A.y)*f,A.z+(B.z-A.z)*f);
    if(p){sx.fillStyle='#F1D9A6';sx.globalAlpha=.9*Math.min(1,p.s*2);sx.shadowColor='#D4A054';sx.shadowBlur=16;sx.beginPath();sx.arc(p.x,p.y,2.5*Math.max(.5,p.s*1.5),0,6.283);sx.fill();sx.shadowBlur=0}}}
  // the open panel is frosted glass: nothing sharp (labels) is drawn beneath it, so its text never sits over other text
  const pr=active?panel.getBoundingClientRect():null;const underPanel=(x:number,y:number)=>!!pr&&x>pr.left-24&&x<pr.right+24&&y>pr.top-24&&y<pr.bottom+24;
  // nodes, far to near
  hover=null;const order=[...NODES].sort((a,b)=>b.z-a.z);
  for(const n of order){const p=P[n.id];if(!p)continue;
    const vis=Math.min(1,p.s*2.4)*(p.d<-100?Math.max(0,1+(p.d+100)/(F*0.45)):1);       // dim when far, fade out as it passes the camera
    const base=(n.k==='course'?11:n.k==='credential'?8:7)*Math.max(.25,2.4*p.s*p.s+.6*p.s);   // steeper than linear: near nodes clearly larger than far ones
    const dd=Math.hypot(ptr.x-p.x,ptr.y-p.y);const isH=dd<Math.max(26,base*3)&&vis>.3;if(isH)hover=n;
    const isA=active&&active.id===n.id;const r=base*(isH||isA?1.5:1);
    const haze=Math.min(1,Math.max(0,(0.55-p.s)*2.2));                                   // far = cooler, dimmer
    const col=haze>0?mix(n.c,'#6B87A0',haze*0.7):n.c;
    sx.globalAlpha=.18*vis*(1-haze*.5);sx.fillStyle=col;sx.beginPath();sx.arc(p.x,p.y,r*2.6,0,6.283);sx.fill();
    sx.globalAlpha=vis*(1-haze*.35);sx.beginPath();sx.arc(p.x,p.y,r,0,6.283);sx.fill();
    if(isA){sx.strokeStyle=n.c;sx.globalAlpha=.7;sx.lineWidth=1.2;sx.beginPath();sx.arc(p.x,p.y,r*2.2+Math.sin(now/300)*2,0,6.283);sx.stroke()}
    if(n.sats){const reveal=Math.max(isA?1:0,isH?.8:0,Math.min(1,Math.max(0,(p.s-0.75)/.5)));
      if(reveal<1){sx.strokeStyle=n.c;sx.globalAlpha=.22*(1-reveal)*vis;sx.lineWidth=.8;sx.setLineDash([2,5]);sx.beginPath();sx.arc(p.x,p.y,r*2.9,0,6.283);sx.stroke();sx.setLineDash([])}
      if(reveal>.02)n.sats.forEach((st:any,k:number)=>{const ang=now/9000+k*(6.283/n.sats.length),orb=(58+n.sats.length*5+k*6)*p.s*1.4*(0.6+.4*reveal),qx=p.x+Math.cos(ang)*orb,qy=p.y+Math.sin(ang)*orb*.55;
        sx.strokeStyle='#6FA8BF';sx.globalAlpha=.16*reveal*vis;sx.lineWidth=.8;sx.beginPath();sx.moveTo(p.x,p.y);sx.lineTo(qx,qy);sx.stroke();
        sx.fillStyle='#9FB0BE';sx.globalAlpha=.85*reveal*vis;sx.beginPath();sx.arc(qx,qy,3*Math.max(.5,p.s*1.3),0,6.283);sx.fill();
        if(isA&&!underPanel(qx,qy)){sx.globalAlpha=.85;sx.fillStyle='#EEF2F5';sx.font=`500 ${Math.max(10,Math.min(16,11*p.s*1.7)).toFixed(1)}px "IBM Plex Sans"`;sx.shadowColor='rgba(4,9,15,.9)';sx.shadowBlur=6;sx.fillText(st.n,qx+7,qy+4);sx.shadowBlur=0}})}
    // labels appear as things approach
    // labels scale with distance: large up front, small in the background, growing as the camera approaches
    const show=(p.s>.26||isH||isA)&&vis>.25&&p.x>0&&p.x<SW&&!underPanel(p.x,p.y);                           // no label for a node whose dot is off the canvas (it would read as a clipped fragment)
    if(show){const la=Math.min(1,(p.s-.2)*3.5)*vis;sx.shadowColor='rgba(4,9,15,.9)';sx.shadowBlur=8;sx.shadowOffsetY=1;const fs=Math.max(9,Math.min(30,34*Math.pow(p.s,1.15))),fs2=Math.max(9,fs*.85);
      sx.globalAlpha=(isH||isA?1:.9)*la;sx.font=`600 ${fs.toFixed(1)}px "IBM Plex Sans"`;sx.fillStyle='#EEF2F5';sx.fillText(n.n.split(' · ')[0],p.x+r+10,p.y-2);
      sx.globalAlpha=.8*la;sx.font=`500 ${fs2.toFixed(1)}px "IBM Plex Serif"`;sx.fillStyle='#B8C6D1';sx.fillText(n.short||n.t,p.x+r+10,p.y+fs2*1.15);sx.shadowBlur=0;sx.shadowOffsetY=0}
  }
  sc.style.cursor=hover?'pointer':'grab';sx.globalAlpha=1;
  {const a=wave(SW*0.18,SH*0.8,.5),bq=wave(SW*0.8,SH*0.5,.5);hud.style.transform=`translate(${(a.ox*.18).toFixed(2)}px,${(a.oy*.18).toFixed(2)}px)`;panel.style.setProperty('--wx',(bq.ox*.15).toFixed(2)+'px');panel.style.setProperty('--wy',(bq.oy*.15).toFixed(2)+'px')}
  requestAnimationFrame(draw);
}
if(reduced){
  // static fallback: no canvas, no dolly, no wave, no comets. The destination list is visible via CSS.
  document.getElementById('hudhint')!.textContent='Motion is reduced on this device, so the map is shown as a list. Choose a destination below.';
}else{
  if(matchMedia('(pointer:coarse)').matches)document.getElementById('hudhint')!.textContent='Tap a point to travel to it. Swipe up to move through the courses; swipe down to return.';
  requestAnimationFrame(draw);
}

/* interaction */
const plink=document.getElementById('plink') as HTMLAnchorElement;
function openNode(n:any){active=n;pathIdx=PATH.indexOf(n.id);
  const mob=innerWidth<820;
  tgt.z=n.z-(mob?520:620);                                   // stop just short of the node
  tgt.x=n.x+(mob?0:SW*0.18*(F+620)/F);tgt.y=n.y+(mob?SH*0.16:0);   // aim so the node sits left of centre, leaving room for the panel
  mapEl.classList.add('focused');
  document.getElementById('pkind')!.textContent=n.n;document.getElementById('ptitle')!.textContent=n.t;document.getElementById('pdesc')!.textContent=n.d+(n.sats?' Includes: '+n.sats.map((x:any)=>x.n).join(', ')+'.':'');
  plink.textContent=n.link||'See the course';plink.href=n.href;
  document.getElementById('pnext')!.style.display=courseFrom(n,1)?'':'none';   // no Deeper on the last course or past it
  panel.dataset.kind=n.k;                                     // the panel takes the node's colour: course, credential, or page
  panel.classList.add('open')}
function closeP(){active=null;panel.classList.remove('open');mapEl.classList.remove('focused');fit()}
document.getElementById('pclose')!.onclick=closeP;document.getElementById('pback')!.onclick=closeP;
document.getElementById('recenter')!.onclick=closeP;
document.getElementById('pnext')!.onclick=()=>{const n=courseFrom(active,1);if(n)openNode(n)};
document.getElementById('pprev')!.onclick=()=>{const n=courseFrom(active,-1);if(n)openNode(n);else closeP()};

let down:any=null;
sc.addEventListener('pointerdown',e=>{down={x:e.clientX,y:e.clientY,cx:tgt.x,cy:tgt.y,moved:false};sc.setPointerCapture(e.pointerId)});
sc.addEventListener('pointermove',e=>{ptr.x=e.clientX;ptr.y=e.clientY;tilt.x=(e.clientX/SW-.5)*2;tilt.y=(e.clientY/SH-.5)*2;
  if(down){const dx=e.clientX-down.x,dy=e.clientY-down.y;if(Math.hypot(dx,dy)>6)down.moved=true;if(down.moved){const s=F/(F+600);tgt.x=down.cx-dx/s;tgt.y=down.cy-dy/s}}});
sc.addEventListener('pointerup',e=>{if(!down)return;if(!down.moved){if(hover)openNode(hover);else{rip.push({x:e.clientX,y:e.clientY,r:0,amp:0,life:0,born:performance.now()});if(rip.length>5)rip.shift()}}down=null});
sc.addEventListener('pointerleave',()=>{ptr.x=ptr.y=-1e4});
// scroll / swipe travels forward along the pathway
let acc=0,lock=0;
sc.addEventListener('wheel',e=>{e.preventDefault();acc+=e.deltaY;if(Math.abs(acc)>140&&performance.now()>lock){const dir=acc>0?1:-1;acc=0;lock=performance.now()+700;
  step(dir)}},{passive:false});
function step(dir:number){if(!active){if(dir>0)openNode(byId[ORDER[0]]);return}const n=courseFrom(active,dir);if(n)openNode(n);else if(dir<0)closeP()}
let ty0:number|null=null;sc.addEventListener('touchstart',e=>{ty0=e.touches[0].clientY},{passive:true});
sc.addEventListener('touchend',e=>{if(ty0===null)return;const dy=ty0-e.changedTouches[0].clientY;ty0=null;if(Math.abs(dy)<50)return;const dir=dy>0?1:-1;
  step(dir)});
sc.addEventListener('dblclick',()=>closeP());
addEventListener('keydown',e=>{if(!document.body.classList.contains('map')||reduced)return;
  const tag=(e.target as HTMLElement).tagName;if(tag==='INPUT'||tag==='TEXTAREA')return;
  if(e.key==='Escape')closeP();if(e.key==='ArrowRight'||e.key==='ArrowDown'){e.preventDefault();step(1)}if(e.key==='ArrowLeft'||e.key==='ArrowUp'){e.preventDefault();step(-1)}});

/* hooks for hands-free control (HandsFree.astro): synthetic pointer, click, travel, tilt. Mouse, keyboard and touch keep working alongside. */
(window as any).aidtMap={
  pointer(x:number,y:number){ptr.x=x;ptr.y=y},
  tilt(x:number,y:number){tilt.x=x;tilt.y=y},
  click(x:number,y:number){ptr.x=x;ptr.y=y;if(hover)openNode(hover);else{rip.push({x,y,r:0,amp:0,life:0,born:performance.now()});if(rip.length>5)rip.shift()}},
  // hand-sized hit test: the nearest visible node within R pixels, else a wave. Returns the node id or null.
  nodeAt(x:number,y:number,R:number){let best:any=null,bd=R;for(const n of NODES){const p=proj(n.x,n.y,n.z);if(!p)continue;const vis=Math.min(1,p.s*2.4)*(p.d<-100?Math.max(0,1+(p.d+100)/(F*0.45)):1);if(vis<.3)continue;const dd=Math.hypot(p.x-x,p.y-y);if(dd<bd){bd=dd;best=n}}return best?best.id:null},
  clickNear(x:number,y:number,R:number){const id=(this as any).nodeAt(x,y,R);if(id)openNode(byId[id]);else{rip.push({x,y,r:0,amp:0,life:0,born:performance.now()});if(rip.length>5)rip.shift()}return id},
  step,close:closeP,
  hovering:()=>!!hover,active:()=>!!active,
};

/* ambient sound: generated pad, off until pressed */
const sbtn=document.getElementById('sound')!;let ac:AudioContext,master:GainNode,timer:any;
const CHORDS=[[261.6,329.6,392,493.9],[220,277.2,329.6,415.3],[196,246.9,293.7,392],[174.6,220,261.6,349.2]];
function note(f:number,dur:number,gainDb:number){
  const o=ac.createOscillator(),g=ac.createGain(),o2=ac.createOscillator();
  o.type='sine';o2.type='triangle';o.frequency.value=f;o2.frequency.value=f*2.003;
  g.gain.setValueAtTime(0,ac.currentTime);g.gain.linearRampToValueAtTime(gainDb,ac.currentTime+dur*.35);g.gain.linearRampToValueAtTime(0,ac.currentTime+dur);
  o.connect(g);o2.connect(g);g.connect(master);o.start();o2.start();o.stop(ac.currentTime+dur);o2.stop(ac.currentTime+dur);
}
let ci=0;
function bar(){
  const ch=CHORDS[ci%CHORDS.length];ci++;
  ch.forEach(f=>note(f/2,7,0.06));
  ch.forEach((f,i)=>setTimeout(()=>note(f*2,1.6,0.05),i*900+Math.random()*300));
}
let noiseBuf:AudioBuffer;
let echo:{in:ConvolverNode};
function getEcho(){ if(echo)return echo;
  // synthesized reverb: dense decaying reflections that darken as they fade (distance, not repetition)
  const len=Math.floor(ac.sampleRate*2.6),ir=ac.createBuffer(2,len,ac.sampleRate);
  for(let ch=0;ch<2;ch++){const d=ir.getChannelData(ch);let lp=0;for(let i=0;i<len;i++){const t=i/len;const n=(Math.random()*2-1)*Math.pow(1-t,2.6)*(i<400?i/400:1);lp+=(n-lp)*(0.35-0.3*t);d[i]=lp*1.8}}
  const cv=ac.createConvolver();cv.buffer=ir;const wet=ac.createGain();wet.gain.value=0.9;cv.connect(wet);wet.connect(master);echo={in:cv};return echo}
function cometSound(kind:string,dir:number){ if(!ac||ac.state!=='running')return;
  if(!noiseBuf){noiseBuf=ac.createBuffer(1,ac.sampleRate*3,ac.sampleRate);const d=noiseBuf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1}
  const t0=ac.currentTime,dur=kind==='recede'?2.4:2.0;
  const pan=ac.createStereoPanner?ac.createStereoPanner():null;
  if(pan){pan.pan.setValueAtTime(kind==='recede'?dir*0.6:-dir*0.7,t0);pan.pan.linearRampToValueAtTime(kind==='recede'?0:dir*0.7,t0+dur)}
  const bus=ac.createGain();bus.gain.value=0.85;if(pan){bus.connect(pan);pan.connect(master)}else bus.connect(master);
  bus.connect(getEcho().in);
  // laser tone: fast bright arrival, long downward slide into the distance
  const fStart=kind==='approach'?2600:3400,fEnd=kind==='approach'?420:260;
  [0,7].forEach((det,i)=>{const o=ac.createOscillator();o.type=i?'triangle':'sine';o.detune.value=det;
    o.frequency.setValueAtTime(fStart,t0);o.frequency.exponentialRampToValueAtTime(fStart*0.8,t0+0.12);o.frequency.exponentialRampToValueAtTime(fEnd,t0+dur);
    const g=ac.createGain();g.gain.setValueAtTime(0.0001,t0);g.gain.exponentialRampToValueAtTime(i?0.03:0.075,t0+0.06);g.gain.exponentialRampToValueAtTime(0.02,t0+dur*0.35);g.gain.exponentialRampToValueAtTime(0.0001,t0+dur);
    o.connect(g);g.connect(bus);o.start(t0);o.stop(t0+dur+0.05)});
  // thin layer of air under the tone
  const src=ac.createBufferSource();src.buffer=noiseBuf;const bp=ac.createBiquadFilter();bp.type='bandpass';bp.Q.value=2.5;
  bp.frequency.setValueAtTime(fStart,t0);bp.frequency.exponentialRampToValueAtTime(fEnd*1.5,t0+dur);
  const ng=ac.createGain();ng.gain.setValueAtTime(0.0001,t0);ng.gain.exponentialRampToValueAtTime(0.022,t0+0.08);ng.gain.exponentialRampToValueAtTime(0.0001,t0+dur*0.8);
  src.connect(bp);bp.connect(ng);ng.connect(bus);src.start(t0);src.stop(t0+dur);
}
function startSound(){
  ac=ac||new (window.AudioContext||(window as any).webkitAudioContext)();
  master=master||(()=>{const g=ac.createGain(),lp=ac.createBiquadFilter();lp.type='lowpass';lp.frequency.value=1400;g.gain.value=0.9;g.connect(lp);lp.connect(ac.destination);return g})();
  ac.resume();bar();timer=setInterval(bar,6000);
}
function stopSound(){clearInterval(timer);if(ac)ac.suspend()}
sbtn.addEventListener('click',()=>{
  const on=sbtn.getAttribute('aria-pressed')!=='true';
  sbtn.setAttribute('aria-pressed',String(on));sbtn.setAttribute('aria-label',on?'Experience: turn off sound, immersive visuals and hands-free camera control':'Experience: turn on sound, immersive visuals and hands-free camera control (video stays on this device)');
  document.body.classList.toggle('ambient',on);if(on)nextComet=performance.now()+2500;
  on?startSound():stopSound();
  dispatchEvent(new CustomEvent('aidt:experience',{detail:{on}}));   // HandsFree.astro starts or stops camera control
});
</script>
