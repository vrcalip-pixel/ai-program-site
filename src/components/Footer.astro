---
import program from '../data/program.json';
import { url } from '../lib/url';
---
<footer class="site">
  <div class="wrap">
    <div>
      <div>{program.degree} · {program.college}</div>
      <div style="margin-top:6px">Program site maintained by program faculty. Official catalog information lives at <a href={program.collegeUrl}>lbcc.edu</a>.</div>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href={url('/')}>Explore the map</a></li>
        <li><a href={url('/pathway')}>Pathway</a></li>
        <li><a href={url('/counselors')}>For counselors</a></li>
        <li><a href={url('/employers')}>For employers</a></li>
        <li><a href={url('/about')}>About</a></li>
        <li><a href={url('/request-info')}>Request info</a></li>
      </ul>
    </nav>
  </div>
</footer>
