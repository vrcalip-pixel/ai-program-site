---
/**
 * Hands-free control for the landing map (BRIEF §10), part of the Experience toggle.
 * Stack: MediaPipe Tasks Vision Hand Landmarker, WASM/GPU, entirely in the browser. The runtime is bundled from the
 * npm package and its WASM is served from this site (public/mediapipe/wasm, copied by scripts/copy-mediapipe.mjs).
 * The model file is fetched from Google's model bucket the first time Experience is turned on and cached by the
 * browser. No frames are ever recorded, uploaded or stored. Starts when DepthMap.astro dispatches `aidt:experience`
 * with on=true; stops when it dispatches on=false. If the camera is declined or missing, Experience keeps its sound
 * and visuals and a one-line notice explains.
 *
 * Four gestures (simplified 2026-09-07 after real use; the earlier pinch, palm push/pull, head turn, nod and shake
 * were hard to perform reliably):
 *   point .......... the index fingertip drives a cursor; nodes and buttons highlight under it
 *   hold ........... rest the cursor on a node or button for about 1.5 s; a ring fills, then it activates
 *   swipe left ..... next (Deeper), as if scrolling on
 *   swipe right .... back
 * Steadiness: a One Euro filter on the fingertip, a central slice of the camera frame mapped to the whole screen
 * (less arm travel), and the cursor eased every animation frame between camera frames. Only one model runs, so the
 * loop tracks at the camera's frame rate. The interpretation lives in src/lib/gestures.ts (unit tests in tests/).
 *
 * Tuning from real use: every threshold is in TUNE below. Open the map with ?hf=debug for a live overlay (frame rate,
 * cursor speed, dwell progress, last gesture); ?hf=nodebug hides it. To try values without a rebuild, set
 * localStorage "hf.tune" to a JSON object with the keys to override, e.g. {"dwellMs":1200}, and turn Experience off
 * and on.
 */
import { BASE } from '../lib/url';
---
<video class="hf-cam" id="hfcam" playsinline muted autoplay aria-hidden="true"></video>
<div class="hf-cursor" id="hfcursor" aria-hidden="true"><i class="ring"></i></div>
<div class="hf-notice" id="hfnotice" role="alert" hidden data-base={BASE}></div>
<pre class="hf-debug" id="hfdebug" hidden aria-hidden="true"></pre>
<div class="hf-legend" id="hflegend" hidden aria-label="Hands-free gestures">
  <div class="cam">Camera on · video stays on this device</div>
  <ul>
    <li data-g="point"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12V4.5a1.5 1.5 0 0 1 3 0V11"/><path d="M12 11V9.5a1.5 1.5 0 0 1 3 0V13"/><path d="M15 12.5a1.5 1.5 0 0 1 3 0V15"/><path d="M9 12l-1.6-1.6a1.6 1.6 0 0 0-2.6 1.3c.2 3.3 1.3 5.8 3.7 7.8 1 .9 2.3 1.5 3.7 1.5H14a4 4 0 0 0 4-4v-2"/></svg><b>Point</b><span>cursor</span></li>
    <li data-g="hold"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 3.5a8.5 8.5 0 0 1 8.5 8.5"/><circle cx="12" cy="12" r="2.2"/></svg><b>Hold</b><span>select</span></li>
    <li data-g="next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5"/><path d="m10 7-5 5 5 5"/></svg><b>Swipe left</b><span>next</span></li>
    <li data-g="back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15"/><path d="m14 7 5 5-5 5"/></svg><b>Swipe right</b><span>back</span></li>
  </ul>
</div>

<script>
  import { OneEuro, Swipe, Dwell } from '../lib/gestures';

  const MODEL = 'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task';

  // Thresholds. Tune from real use; see the notes at the top of this file.
  const TUNE = {
    reach: 0.6,           // fraction of the camera frame (centred) that maps to the whole screen: smaller = less arm travel
    filterMinCutoff: 1.0, // One Euro: lower = steadier when still (more lag)
    filterBeta: 0.02,     // One Euro: higher = quicker to follow fast movement
    cursorEase: 0.45,     // per animation frame, how far the drawn cursor moves toward the filtered target (0..1)
    hitRadius: 64,        // px: a node within this distance of the cursor counts as under it
    dwellMs: 1500,        // hold this long over a node or button to activate it
    dwellRadius: 26,      // px: the cursor may wander this far while holding
    dwellRearm: 70,       // px: after activating, move this far away before another hold can fire
    swipeWindow: 450,     // ms over which a swipe is judged
    swipeMinDx: 0.28,     // fraction of frame width the wrist must travel sideways
    swipeMaxDyRatio: 0.6, // vertical travel allowed, as a fraction of the sideways travel
    navGap: 900,          // ms between swipes
    minFps: 15,           // below this (after the first window) camera control turns itself off
    fpsWindow: 3000,      // ms per frame-rate measurement
  };
  try { Object.assign(TUNE, JSON.parse(localStorage.getItem('hf.tune') || '{}')); } catch { /* ignore */ }

  const cam = document.getElementById('hfcam') as HTMLVideoElement;
  const cursor = document.getElementById('hfcursor')!;
  const notice = document.getElementById('hfnotice')!;
  const legend = document.getElementById('hflegend')!;
  const debugEl = document.getElementById('hfdebug')!;
  const BASE = notice.dataset.base || '';
  const map = () => (window as any).aidtMap;

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const supported = !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia) && isSecureContext;

  {
    const q = new URLSearchParams(location.search).get('hf');
    try { if (q === 'debug') localStorage.setItem('hf.debug', '1'); if (q === 'nodebug') localStorage.removeItem('hf.debug'); } catch { /* ignore */ }
  }
  let debug = false; try { debug = localStorage.getItem('hf.debug') === '1'; } catch { /* ignore */ }

  let on = false, starting = false, stream: MediaStream | null = null, hands: any = null, raf = 0, delegate = '';
  let lastVideoTime = -1, frames = 0, fpsT0 = 0, warm = 0, frameNo = 0, fps = 0;
  const target = { x: innerWidth / 2, y: innerHeight / 2 }, cur = { x: innerWidth / 2, y: innerHeight / 2 };
  let handSeen = false, lastNav = 0, lastGesture = '', lastGestureAt = 0, lastTargetKey: string | null = null, dwellProgress = 0, speed = 0, lastT = 0;
  const fx = new OneEuro(TUNE.filterMinCutoff, TUNE.filterBeta), fy = new OneEuro(TUNE.filterMinCutoff, TUNE.filterBeta);
  const swipe = new Swipe({ windowMs: TUNE.swipeWindow, minDx: TUNE.swipeMinDx, maxDyRatio: TUNE.swipeMaxDyRatio });
  const dwell = new Dwell({ ms: TUNE.dwellMs, radius: TUNE.dwellRadius, rearm: TUNE.dwellRearm });
  const flashTimers: Record<string, any> = {};
  let hideTimer: any = 0;
  const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

  function flash(g: string) {
    lastGesture = g; lastGestureAt = performance.now();
    const row = legend.querySelector<HTMLElement>(`[data-g="${g}"]`); if (!row) return;
    row.classList.add('hit'); clearTimeout(flashTimers[g]); flashTimers[g] = setTimeout(() => row.classList.remove('hit'), 700);
  }
  function showNotice(text: string) { notice.textContent = text; notice.hidden = false; setTimeout(() => { notice.hidden = true; }, 6000); }

  addEventListener('aidt:experience', (e: Event) => {
    const wantOn = !!(e as CustomEvent).detail?.on;
    if (!wantOn || reduced) { stop(); return; }
    if (!supported) { stop("Hands-free control isn't available here (it needs a camera and a secure connection). Sound and visuals are on; mouse, keyboard and touch work as usual."); return; }
    start();
  });

  async function start() {
    if (on || starting) return; starting = true;
    try {
      stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 }, frameRate: { ideal: 60 } }, audio: false });
      cam.srcObject = stream; await cam.play();
      const mp: any = await import('@mediapipe/tasks-vision');
      const vision = await mp.FilesetResolver.forVisionTasks(`${BASE}/mediapipe/wasm`);
      const make = async (del: 'GPU' | 'CPU') => { const h = await mp.HandLandmarker.createFromOptions(vision, { baseOptions: { modelAssetPath: MODEL, delegate: del }, runningMode: 'VIDEO', numHands: 1 }); delegate = del; return h; };
      try { hands = await make('GPU'); } catch { hands = await make('CPU'); }
      if (!document.body.classList.contains('ambient')) { starting = false; stop(); return; }
      on = true; frames = 0; warm = 0; fps = 0; fpsT0 = performance.now(); lastVideoTime = -1; handSeen = false;
      fx.reset(); fy.reset(); swipe.reset(); dwell.reset();
      document.body.classList.add('handsfree');
      clearTimeout(hideTimer); legend.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => legend.classList.add('show')));
      if (debug) debugEl.hidden = false;
      loop();
    } catch (err: any) {
      const name = err && err.name;
      const why = name === 'NotAllowedError' ? 'Camera permission was declined.' : name === 'NotFoundError' ? 'No camera was found.' : 'The tracking model could not be loaded.';
      stop(`Hands-free control is off. ${why} Sound and visuals stay on; mouse, keyboard and touch work as usual.`);
      if (debug) console.warn('hands-free:', err);
    }
    starting = false;
  }

  function stop(msg?: string) {
    on = false; cancelAnimationFrame(raf);
    if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
    cam.srcObject = null;
    try { hands && hands.close(); } catch { /* ignore */ }
    hands = null;
    document.body.classList.remove('handsfree');
    legend.classList.remove('show'); clearTimeout(hideTimer); hideTimer = setTimeout(() => { legend.hidden = true; }, 750);
    cursor.classList.remove('on'); cursor.style.setProperty('--p', '0'); debugEl.hidden = true;
    if (map()) { map().pointer(-1e4, -1e4); }
    if (msg) showNotice(msg);
  }

  // what is under the cursor: a panel or nav control, else the nearest visible node within hitRadius, else nothing
  function targetAt(x: number, y: number): { key: string; fire: () => void } | null {
    const el = document.elementFromPoint(x, y);
    const ctrl = el && (el.closest('#panel a, #panel button, .hud button, .nav a, .nav button, .ask-pill, .ask a, .ask button') as HTMLElement | null);
    if (ctrl) return { key: 'el:' + (ctrl.id || ctrl.textContent), fire: () => ctrl.click() };
    const id = map().nodeAt(x, y, TUNE.hitRadius);
    if (id) return { key: 'node:' + id, fire: () => map().clickNear(x, y, TUNE.hitRadius) };
    return null;
  }

  function renderDebug(now: number) {
    const ago = lastGesture ? `${lastGesture} ${((now - lastGestureAt) / 1000).toFixed(1)}s ago` : '–';
    debugEl.textContent =
      `hands-free debug  ${delegate}  ${fps.toFixed(0)} fps\n` +
      `hand   ${handSeen ? 'yes' : 'no '}  cursor ${cur.x.toFixed(0)},${cur.y.toFixed(0)}  speed ${speed.toFixed(0)} px/s\n` +
      `over   ${lastTargetKey || '–'}  hold ${(dwellProgress * 100).toFixed(0)}%\n` +
      `last   ${ago}`;
  }

  function loop() {
    if (!on) return;
    raf = requestAnimationFrame(loop);
    const now = performance.now();

    // the drawn cursor eases toward the filtered target every animation frame, so it moves smoothly between camera frames
    if (handSeen) {
      const px = cur.x, py = cur.y;
      cur.x += (target.x - cur.x) * TUNE.cursorEase; cur.y += (target.y - cur.y) * TUNE.cursorEase;
      const dt = Math.max(1, now - lastT); speed = speed * 0.8 + (Math.hypot(cur.x - px, cur.y - py) / dt * 1000) * 0.2;
      cursor.style.transform = `translate(${cur.x.toFixed(1)}px,${cur.y.toFixed(1)}px)`;
      map().pointer(cur.x, cur.y);
    }
    lastT = now;

    if (cam.currentTime === lastVideoTime) return;                 // no new camera frame yet
    lastVideoTime = cam.currentTime; frames++; frameNo++;

    if (now - fpsT0 > TUNE.fpsWindow) {
      fps = frames * 1000 / (now - fpsT0); frames = 0; fpsT0 = now;
      if (warm >= 1 && fps < TUNE.minFps) { stop(`Hands-free control turned off: this device can't track fast enough (under ${TUNE.minFps} frames a second). Sound and visuals stay on.`); return; }
      warm++;
    }

    const hr = hands.detectForVideo(cam, now);
    const lm = hr && hr.landmarks && hr.landmarks[0];
    if (lm) {
      const W = innerWidth, H = innerHeight;
      const tip = lm[8], wrist = lm[0];
      // mirrored, then the central `reach` slice of the frame stretched to the whole screen
      const nx = clamp(((1 - tip.x) - (0.5 - TUNE.reach / 2)) / TUNE.reach, 0, 1);
      const ny = clamp((tip.y - (0.5 - TUNE.reach / 2)) / TUNE.reach, 0, 1);
      target.x = fx.filter(nx * W, now); target.y = fy.filter(ny * H, now);
      if (!handSeen) { handSeen = true; cur.x = target.x; cur.y = target.y; cursor.classList.add('on'); flash('point'); }

      // swipe: the wrist travelling sideways across the frame (raw x grows toward the viewer's left because the image is mirrored)
      const dir = swipe.push(wrist.x, wrist.y, now);
      if (dir && now - lastNav > TUNE.navGap) {
        lastNav = now; dwell.reset();
        if (dir > 0) { map().step(1); flash('next'); } else { map().step(-1); flash('back'); }
      }

      // hold: rest on a node or button to activate it; the ring on the cursor shows progress
      const t = speed > 900 ? null : targetAt(cur.x, cur.y);          // a fast-moving hand is not holding
      lastTargetKey = t ? t.key : null;
      const d = dwell.update(cur.x, cur.y, now, t ? t.key : null);
      dwellProgress = d.progress; cursor.style.setProperty('--p', d.progress.toFixed(3));
      if (d.fire && t) { t.fire(); flash('hold'); }
    } else if (handSeen) {
      handSeen = false; cursor.classList.remove('on'); cursor.style.setProperty('--p', '0');
      fx.reset(); fy.reset(); swipe.reset(); dwell.reset(); lastTargetKey = null; dwellProgress = 0;
      map().pointer(-1e4, -1e4);
    }

    if (debug && frameNo % 3 === 0) renderDebug(now);
  }

  addEventListener('pagehide', () => { if (on) stop(); });
</script>
