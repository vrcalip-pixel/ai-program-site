---
/**
 * Industry credentials that sit alongside the six AI courses: IBM, Microsoft, Google, OpenAI, Anthropic, AWS.
 * A band in the palette's lighter plum (--plum-2) so it reads as a different zone from the midnight page, holding
 * near-square flip cards: front = text mark, issuer, name, tagline, cost; back = what it is, cost detail, where it sits
 * in the program, the issuer's page. Click or tap anywhere on a card to flip it (no buttons: the front face is the
 * button, keyboard Enter/Space flips it, Escape or a focus-only "Flip back" control returns it). The hidden face is
 * `inert` so its links never take focus; focus moves to the newly shown face. Reduced motion
 * swaps faces without the turn. Data in src/data/credentials.json. Text marks, not logos: third-party logos need
 * each owner's brand permission and their colours, which BRIEF §4 rules out.
 */
import type { CollectionEntry } from 'astro:content';
import creds from '../data/credentials.json';
import { url } from '../lib/url';

interface Props { courses: CollectionEntry<'courses'>[] }
const { courses } = Astro.props;
const byId = Object.fromEntries(courses.map(c => [c.id, c]));
---
<section class="block tint" id="industry" aria-labelledby="industry-h">
  <div class="wrap">
    <span class="eyebrow">Beyond the transcript</span>
    <h2 id="industry-h">Industry credentials, earned alongside the courses</h2>
    <p class="why">Open, public credentials from companies students will meet in job postings, which complement the LBCC certificates and degree. Most are free; two are inexpensive proctored exams. None is required, and none carries LBCC units, but a student who finishes AI 45 with an IBM badge and a Microsoft certification beside it has more to show an employer. Select a card for details.</p>
    <ul class="creds">
      {creds.items.map(c => (
        <li class="flip" id={`cred-${c.id}`}>
          <div class="flip-inner">
            <div class="face front" role="button" tabindex="0" aria-expanded="false" aria-controls={`cred-${c.id}-back`}>
              <div class="mark" aria-hidden="true"><span>{c.mark}</span></div>
              <span class="issuer">{c.issuer}</span>
              <h3 id={`cred-${c.id}-h`}>{c.name}</h3>
              <p class="tag">{c.tagline}</p>
              <div class="foot">
                <span class="cost">{c.cost}</span>
                <span class="vh">, select for details</span>
              </div>
            </div>
            <div class="face back" id={`cred-${c.id}-back`} tabindex="-1" aria-labelledby={`cred-${c.id}-h`} inert>
              <span class="issuer">{c.issuer}</span><span class="kind">{c.kind}</span>
              <p class="what">{c.what}</p>
              <dl>
                <dt>Cost</dt><dd><b>{c.cost}</b> <small>{c.costNote}</small></dd>
                <dt>In the program</dt><dd>{c.status} {c.pairs.map((id, i) => <>{i > 0 && ' and '}<a href={url(`/courses/${id}`)}>{byId[id].data.number}</a></>)}{c.statusNote ? <small>{c.statusNote}</small> : null}</dd>
              </dl>
              <div class="foot">
                <a class="issuer-link" href={c.url} rel="noopener">{c.issuer} page</a>
                <button type="button" class="flip-back vh-focus">Flip back</button>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="fine">Costs are the issuers' US list prices as of {creds.checked}; check the issuer's page before a student enrolls, since promotions and free-access windows change. Company and product names are trademarks of their owners; their use here is descriptive and implies no endorsement.</p>
  </div>
</section>

<script>
  // flip on click or tap anywhere on the card (links excepted); Enter/Space on the front, Escape or the focus-only
  // "Flip back" control on the back; keep the hidden face inert
  document.querySelectorAll<HTMLElement>('#industry .flip').forEach(card => {
    const front = card.querySelector<HTMLElement>('.front')!, back = card.querySelector<HTMLElement>('.back')!;
    const set = (on: boolean, focus: boolean) => {
      card.classList.toggle('on', on);
      front.toggleAttribute('inert', on); back.toggleAttribute('inert', !on);
      front.setAttribute('aria-expanded', String(on));
      if (focus) (on ? back : front).focus({ preventScroll: true });
    };
    card.addEventListener('click', e => {
      const t = e.target as HTMLElement;
      if (t.closest('a')) return;
      set(!card.classList.contains('on'), !!t.closest('.flip-back') || e.detail === 0);
    });
    front.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); set(true, true); } });
    card.addEventListener('keydown', e => { if (e.key === 'Escape' && card.classList.contains('on')) { set(false, true); } });
  });
  // a card named in the URL hash opens on its own
  const open = () => { const el = location.hash && document.querySelector<HTMLElement>(`#industry .flip${location.hash}`); if (el && !el.classList.contains('on')) el.querySelector<HTMLElement>('.front')!.click(); };
  open(); addEventListener('hashchange', open);
  // print shows both faces
  addEventListener('beforeprint', () => document.querySelectorAll('#industry .face').forEach(f => f.removeAttribute('inert')));
</script>
