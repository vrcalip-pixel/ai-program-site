---
import program from '../data/program.json';
import { url } from '../lib/url';

interface Props { current?: string }
const { current } = Astro.props;

// Menu contents per BRIEF §3. No course links: the map is the course navigation.
// "Request info" lives only in the menu (the separate nav button was removed to keep the landing page minimal).
const items = [
  { href: url('/about'), label: 'About', id: 'about' },
  { href: url('/pathway'), label: 'Pathway', id: 'pathway' },
  { href: url('/counselors'), label: 'Counselors', id: 'counselors' },
  { href: url('/employers'), label: 'Employers', id: 'employers' },
  { href: url('/request-info'), label: 'Request info', id: 'request' },
  { href: url('/'), label: 'Return to the map', id: 'home' },
];
---
<nav class="nav" aria-label="Primary">
  <div class="wrap">
    <a class="brand" href={url('/')}>{program.name}</a>
    <div class="right">
      <button type="button" class="menu" id="menuBtn" aria-expanded="false" aria-controls="drawer" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>
</nav>
<div class="drawer" id="drawer" role="region" aria-label="Menu">
  <ul class="links">
    {items.map(i => <li><a href={i.href} aria-current={current === i.id ? 'page' : undefined}>{i.label}</a></li>)}
  </ul>
</div>

<script>
  /* drawer — from the prototypes */
  const drawer = document.getElementById('drawer')!;
  const toggles = [document.getElementById('menuBtn')!];
  function setDrawer(o: boolean) { drawer.classList.toggle('open', o); toggles.forEach(b => b.setAttribute('aria-expanded', String(o))); }
  toggles.forEach(b => b.addEventListener('click', () => setDrawer(!drawer.classList.contains('open'))));
  addEventListener('click', e => { const t = e.target as Element; if (!drawer.contains(t) && !t.closest('#menuBtn')) setDrawer(false); });
  addEventListener('keydown', e => { if (e.key === 'Escape') setDrawer(false); });
</script>
