---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AskProgram from '../components/AskProgram.astro';
import program from '../data/program.json';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** 'map' = the landing page (fixed canvas, no footer). */
  mode?: 'map' | 'page';
  current?: string;
  /** JSON-LD objects (see src/lib/schema.ts); rendered as one script tag per object. */
  jsonLd?: object | object[];
}
const { title, description, mode = 'page', current, jsonLd } = Astro.props;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const fullTitle = title === program.name ? `${program.name} · ${program.college}` : `${title} · ${program.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(url('/og.png'), Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <meta name="theme-color" content="#0B1622" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={`${program.name} · ${program.college}`} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  {ld.map(o => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
</head>
<body class={mode}>
  <a class="skip" href="#main">Skip to content</a>
  <Nav current={current} />
  <slot />
  {mode === 'page' && <Footer />}
  <AskProgram />
</body>
</html>
