---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import program from '../data/program.json';
import { url } from '../lib/url';
import { breadcrumbs } from '../lib/schema';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="For counselors and advisors" description={`Everything needed to place a student in ${program.name} at ${program.college}: plan code, unit totals, recommended sequence, prerequisites, grading, transfer, and contact.`} current="counselors" jsonLd={breadcrumbs([{ name: 'For counselors and advisors', path: '/counselors' }])}>
  <main id="main" class="page">
    <section class="block" style="padding-top:0">
      <div class="wrap">
        <span class="eyebrow">For counselors and advisors</span>
        <h1>Everything you need to place a student.</h1>
        <p class="intro">Six 3-unit AI courses, no prerequisites, student-choice grading, stacking into three certificates and an Associate in Science. Direct facts below; questions go to the program lead.</p>
      </div>
    </section>

    <section class="block">
      <div class="wrap two">
        <div>
          <h2>Program codes</h2>
          <dl class="facts-dl">
            <dt>Program</dt><dd>{program.degree}</dd>
            <dt>Plan code</dt><dd>{program.codes.planCode}</dd>
            <dt>Control #</dt><dd>{program.codes.controlNumber}</dd>
            <dt>CIP</dt><dd>{program.codes.cip}</dd>
            <dt>TOP</dt><dd>{program.codes.top}</dd>
            <dt>Approved</dt><dd>{program.approval.body}, {program.approval.date}</dd>
            <dt>Department</dt><dd>{program.department}</dd>
          </dl>
        </div>
        <div>
          <h2>At a glance</h2>
          <dl class="facts-dl">
            <dt>Prerequisites</dt><dd>None, on any of the six AI courses</dd>
            <dt>Units</dt><dd>3 per course; 18 for all six</dd>
            <dt>Hours</dt><dd>54 lecture per course</dd>
            <dt>Grading</dt><dd>Student choice</dd>
            <dt>Transfer</dt><dd>CSU transferable</dd>
            <dt>Delivery</dt><dd>No-code and low-code tools throughout</dd>
          </dl>
        </div>
      </div>
    </section>

    <section class="block">
      <div class="wrap">
        <h2>Credentials and unit totals</h2>
        <div class="tablewrap">
          <table class="data">
            <thead><tr><th>Credential</th><th>Type</th><th>Units</th><th>Courses</th><th>Status</th><th>Financial aid</th></tr></thead>
            <tbody>
              {program.ladder.map(r => (
                <tr>
                  <td><a href={url(`/pathway#${r.id}`)}>{r.name}</a></td>
                  <td>{r.kind}</td>
                  <td>{r.units}</td>
                  <td>{r.id === 'degree' ? 'Six AI courses + supporting courses + general education' : r.courses.join(', ')}</td>
                  <td>{r.status}</td>
                  <td>{r.aidEligible ? 'Eligible (Title IV)' : 'Not aid-eligible'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="color:var(--ink-2);font-size:15px;margin-top:12px;max-width:62ch">Only the 18-unit certificate and the degree are Title IV eligible. The 12-unit certificate is a transcripted credential but is not aid-eligible.</p>
      </div>
    </section>

    <section class="block">
      <div class="wrap">
        <h2>Courses and recommended sequence</h2>
        <p style="color:var(--ink-2);max-width:62ch;margin-bottom:20px">Recommended order: {program.sequenceNote}. AI 60 and AI 65 may be taken in either order. None of the courses has a prerequisite; recommended preparation is advisory.</p>
        <div class="tablewrap">
          <table class="data">
            <thead><tr><th>Course</th><th>Title</th><th>Units</th><th>Formerly</th><th>Recommended preparation</th><th>Counts toward</th></tr></thead>
            <tbody>
              {courses.map(c => (
                <tr>
                  <td><b><a href={url(`/courses/${c.id}`)}>{c.data.number}</a></b></td>
                  <td>{c.data.title}{c.data.capstone ? ' (capstone)' : ''}</td>
                  <td>{c.data.units}</td>
                  <td>{c.data.formerly}</td>
                  <td>{c.data.recommendedPreparationConfirmed ? c.data.recommendedPreparation : 'To be confirmed'}</td>
                  <td><a href={url(`/pathway#${c.data.countsToward.id}`)}>{c.data.countsToward.name.replace(/^the /, '')}</a>; degree</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="block">
      <div class="wrap two">
        <div class="prose">
          <h2>Degree requirements</h2>
          <p>The A.S. is 60 units: the six AI courses (18 units), supporting courses, and general education ({program.generalEducationUnits} units). Supporting courses with outlines on file: {program.supportingCourses.map(s => `${s.number} (${s.title})`).join(', ')}.</p>
          {/* TODO(vincent): supply the full approved degree requirements. */}
          <p>Full requirements: <a href={program.catalogUrl}>see the LBCC catalog</a>.</p>
        </div>
        <div class="prose">
          <h2>Contact</h2>
          <p>{program.facultyAuthor}, {program.facultyRole.toLowerCase()}, {program.department}.</p>
          <p><a class="see" href={url('/request-info?role=counselor')}>Ask a placement question</a></p>
          <p style="font-size:15px">Or email <a href={`mailto:${program.contactEmail}`}>{program.contactEmail}</a>.</p>
          <p>Department Head: {program.departmentHead}. School Dean: {program.schoolDean}.</p>
        </div>
      </div>
    </section>
  </main>
</Base>
