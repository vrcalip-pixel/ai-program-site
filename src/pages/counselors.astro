---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import program from '../data/program.json';
import { url } from '../lib/url';
import { breadcrumbs } from '../lib/schema';
import Plans from '../components/Plans.astro';
import IndustryCredentials from '../components/IndustryCredentials.astro';
import plans from '../data/plans.json';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="For counselors and advisors" description={`Everything needed to place a student in ${program.name} at ${program.college}: plan code, unit totals, recommended sequence, prerequisites, grading, transfer, and contact.`} current="counselors" jsonLd={breadcrumbs([{ name: 'For counselors and advisors', path: '/counselors' }])}>
  <main id="main" class="page hasvideo">
    <header class="chero subpage">
      <div class="video" aria-hidden="true">
        <video autoplay muted loop playsinline preload="metadata" poster={url('/video/counselors.jpg')} width="1280" height="720">
          <source src={url('/video/counselors.webm')} type="video/webm" />
          <source src={url('/video/counselors.mp4')} type="video/mp4" />
        </video>
        <script is:inline>
          // reduced motion: hold the poster frame instead of playing the loop (BRIEF §8)
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) { const v = document.currentScript.previousElementSibling; v.removeAttribute('autoplay'); v.pause(); }
        </script>
      </div>
      <div class="wrap">
        <span class="eyebrow">For counselors and advisors</span>
        <h1>Everything you need to place a student.</h1>
        <p class="intro">Six 3-unit AI courses, no prerequisites, student-choice grading, stacking into three certificates and an Associate in Science. Direct facts below; questions go to the program director.</p>
      </div>
    </header>

    <section class="block">
      <div class="wrap two">
        <div>
          <h2>Program codes</h2>
          <dl class="facts-dl">
            <dt>Program</dt><dd>{program.degree}</dd>
            <dt>Plan code</dt><dd>{program.codes.planCode}</dd>
            <dt>Control #</dt><dd>{program.codes.controlNumber}</dd>
            <dt>CIP</dt><dd>{program.codes.cip}</dd>
            <dt>TOP</dt><dd>{program.codes.top}</dd>
            <dt>Approved</dt><dd>{program.approval.body}, {program.approval.date}</dd>
            <dt>Department</dt><dd>{program.department}</dd>
          </dl>
        </div>
        <div>
          <h2>At a glance</h2>
          <dl class="facts-dl">
            <dt>Prerequisites</dt><dd>None, on any of the six AI courses</dd>
            <dt>Units</dt><dd>3 per course; 18 for all six</dd>
            <dt>Hours</dt><dd>54 lecture per course</dd>
            <dt>Grading</dt><dd>Student choice</dd>
            <dt>Transfer</dt><dd>CSU transferable</dd>
            <dt>Delivery</dt><dd>No-code and low-code tools throughout</dd>
          </dl>
        </div>
      </div>
    </section>

    <section class="block">
      <div class="wrap">
        <h2>Credentials and unit totals</h2>
        <div class="tablewrap" tabindex="0" role="region" aria-label="Credentials and unit totals">
          <table class="data">
            <thead><tr><th>Credential</th><th>Type</th><th>Units</th><th>Courses</th><th>Status</th><th>Financial aid</th></tr></thead>
            <tbody>
              {program.ladder.map(r => (
                <tr>
                  <td><a href={url(`/pathway#${r.id}`)}>{r.name}</a></td>
                  <td>{r.kind}</td>
                  <td>{r.units}</td>
                  <td>{r.id === 'degree' ? 'Six AI courses + supporting courses + general education' : r.courses.join(', ')}</td>
                  <td>{r.status}</td>
                  <td>{r.aidEligible ? 'Eligible (Title IV)' : 'Not aid-eligible'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="color:var(--ink-2);font-size:15px;margin-top:12px;max-width:62ch">Only the 18-unit certificate and the degree are Title IV eligible. The 12-unit certificate is a transcripted credential but is not aid-eligible.</p>
      </div>
    </section>

    <section class="block">
      <div class="wrap">
        <h2>Courses and recommended sequence</h2>
        <p style="color:var(--ink-2);max-width:62ch;margin-bottom:20px">The six AI courses first, then a sample plan for a student pursuing a certificate or the degree. Open the panel that fits the student in front of you.</p>
        <Plans courses={courses} />
      </div>
    </section>

    <IndustryCredentials courses={courses} />

    <section class="block">
      <div class="wrap two">
        <div class="prose">
          <h2>Degree requirements</h2>
          <p>The A.S. is 60 units: the six AI courses (18 units) and three supporting courses, {plans.supporting.map(s => `${s.number} (${s.title}, ${s.units} units)`).join(', ')}, for a {18 + plans.supporting.reduce((n, s) => n + s.units, 0)}-unit core; then general education ({plans.ge.plan}, {plans.ge.unitsMin} units, or Cal-GETC for transfer) and an elective as needed to reach 60 degree-applicable units. A <a href="#plan-degree">sample four-semester plan</a> is above.</p>
          {/* TODO(vincent): confirm the supporting-course units and the GE total against the approved requirements (see src/data/plans.json). */}
          <p>Full requirements: <a href={program.catalogUrl}>see the LBCC catalog</a>.</p>
        </div>
        <div class="prose">
          <h2>Contact</h2>
          <p>{program.facultyAuthor}, {program.facultyRole.toLowerCase()}, {program.department}.</p>
          <p><a class="see" href={url('/request-info?role=counselor')}>Ask a placement question</a></p>
          <p style="font-size:15px">Or email <a href={`mailto:${program.contactEmail}`}>{program.contactEmail}</a>.</p>
          <p>Department Head: {program.departmentHead}. School Dean: {program.schoolDean}.</p>
        </div>
      </div>
    </section>
  </main>
</Base>
